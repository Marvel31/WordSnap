{
  "expo": {
    "name": "WordSnap",
    "slug": "wordsnap",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Take a book photo to extract English words.",
        "NSPhotoLibraryUsageDescription": "Choose a book photo to extract English words."
      }
    },
    "android": {
      "package": "com.marvel31.wordsnap",
      "versionCode": 2,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "ocrSpaceApiKey": "",
      "geminiApiKey": "",
      "geminiModel": "gemini-3.5-flash",
      "eas": {
        "projectId": "17876f05-9a15-4ee5-9ecd-5b24d626f303"
      }
    }
  }
}
